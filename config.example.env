# Copy to config.env and fill in. Then run: ./scripts/install.sh

# Absolute path to your Obsidian vault (no trailing slash)
YOUR_VAULT_PATH=/Users/you/Notes

# Ticket tool — Linear email for "assigned to me" queries
YOUR_LINEAR_EMAIL=you@company.com

# Private Slack channel where you forward commitments + receive nudges
YOUR_REMINDERS_CHANNEL=#your-name-reminders
YOUR_SLACK_CHANNEL_ID=C0123456789
YOUR_SLACK_USER_ID=U0123456789

# Optional — career moments channel for /my-story (leave blank to disable)
YOUR_CAREER_SLACK_CHANNEL=#career-you
YOUR_CAREER_SLACK_CHANNEL_ID=

# Where to install command files: claude | cursor | both
INSTALL_TARGET=both
